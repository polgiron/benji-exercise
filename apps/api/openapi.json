  "components": {
    "schemas": {
      "ActivityBucket": {
        "properties": {
          "start": {
            "type": "string",
            "format": "date-time",
            "title": "Start"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "succeeded": {
            "type": "integer",
            "title": "Succeeded"
          },
          "failed": {
            "type": "integer",
            "title": "Failed"
          }
        },
        "type": "object",
        "required": [
          "start",
          "total",
          "succeeded",
          "failed"
        ],
        "title": "ActivityBucket",
        "description": "Deliveries created in [start, start + bucket_seconds), split by their current status."
      },
      "ActivityRange": {
        "type": "string",
        "enum": [
          "24h",
          "7d",
          "30d"
        ],
        "title": "ActivityRange"
      },
      "AttemptOut": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "number": {
            "type": "integer",
            "title": "Number"
          },
          "trigger": {
            "type": "string",
            "title": "Trigger"
          },
          "started_at": {
            "type": "string",
            "format": "date-time",
            "title": "Started At"
          },
          "duration_ms": {
            "type": "integer",
            "title": "Duration Ms"
          },
          "response_status": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Status"
          },
          "response_body": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Response Body"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "type": "object",
        "required": [
          "id",
          "number",
          "trigger",
          "started_at",
          "duration_ms",
          "response_status",
          "response_body",
          "error"
        ],
        "title": "AttemptOut"
      },
      "DeliveryActivity": {
        "properties": {
          "range": {
            "$ref": "#/components/schemas/ActivityRange"
          },
          "bucket_seconds": {
            "type": "integer",
            "title": "Bucket Seconds"
          },
          "buckets": {
            "items": {
              "$ref": "#/components/schemas/ActivityBucket"
            },
            "type": "array",
            "title": "Buckets"
          }
        },
        "type": "object",
        "required": [
          "range",
          "bucket_seconds",
          "buckets"
        ],
        "title": "DeliveryActivity",
        "description": "Every bucket of the range is present, oldest first; the last one contains now."
      },
      "DeliveryDetail": {
        "properties": {
          "id": {
            "type": "string",
            "title": "Id"
          },
          "event_id": {
            "type": "string",
            "title": "Event Id"
          },
          "event_type": {
            "type": "string",
            "title": "Event Type"
          },
          "endpoint_id": {
            "type": "string",
            "title": "Endpoint Id"
          },
          "endpoint_url": {
            "type": "string",
            "title": "Endpoint Url"
          },
          "status": {
            "type": "string",
            "title": "Status"
          },
          "attempt_count": {
            "type": "integer",
            "title": "Attempt Count"
          },
          "series_attempts": {
            "type": "integer",
            "title": "Series Attempts"
          },
          "max_attempts": {
            "type": "integer",
            "title": "Max Attempts"
          },
          "replay_count": {
            "type": "integer",
            "title": "Replay Count"
          },
          "next_attempt_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Next Attempt At"
          },
          "last_error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Error"
          },
          "version": {
            "type": "integer",
            "title": "Version"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "payload": {
            "additionalProperties": true,
            "type": "object",
            "title": "Payload"
          },
          "attempts": {
            "items": {
              "$ref": "#/components/schemas/AttemptOut"
            },
            "type": "array",
            "title": "Attempts"
          }
        },
        "type": "object",
        "required": [
          "id",
          "event_id",
          "event_type",
          "endpoint_id",
          "endpoint_url",
          "status",
          "attempt_count",
          "series_attempts",
